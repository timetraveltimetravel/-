{
  "manifest_version": 3,
  "name": "스크롤 캡처",
  "version": "0.1.0",
  "description": "웹 페이지를 스크롤할 때 화면을 캡처하고, 사진으로 저장합니다.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "sidePanel", "downloads"],
  "action": {
    "default_title": "스크롤 캡처 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
